# 账号版 Agent 主服务(server/agent-service/main.mjs)的环境变量。它只做控制、不跑任务;任务在任务槽的单元里跑。
# 这是示例,不是可以直接用的文件:尖括号里的换成节点上的值。里面没有任何秘密(私钥只写路径)。
PROMPTCUT_ACCOUNT_V2=1
PROMPTCUT_ACCOUNT_V2_REQUIRED=1
PROMPTCUT_AGENT_DATA=/var/lib/promptcut/agent
PROMPTCUT_AGENT_HOST=127.0.0.1
PROMPTCUT_AGENT_PORT=8790
# 文档服务对页面的地址(账号版必须是 wss)与它的内部口
PROMPTCUT_AGENT_DOC_URL=wss://<主站域名>/hosted/
PROMPTCUT_AGENT_DOC_INTERNAL_ORIGIN=https://127.0.0.1:<文档服务内部口>
PROMPTCUT_AGENT_DOC_FINGERPRINT256=<文档服务内部证书的指纹>
# 主身份(只做控制)的证书:和任务证书不是同一张
PROMPTCUT_AGENT_CLIENT_KEY_FILE=/etc/promptcut/agent-master/master.key
PROMPTCUT_AGENT_CLIENT_CERT_FILE=/etc/promptcut/agent-master/master.crt
PROMPTCUT_AGENT_CA_FILE=/etc/promptcut/agent-master/ca.crt
# 内部口(任务进程交事件、root 入口来问排队与强制终态):只绑回环,和上面的公开口不同
PROMPTCUT_AGENT_INTERNAL_PORT=8792
# root 那张证书(controller.crt)的指纹
PROMPTCUT_AGENT_ROOT_FINGERPRINT256=<controller.crt 的指纹>
# 各代任务进程共用的数据目录:要和 root 入口配置里 worker.dataDir 是同一个
PROMPTCUT_AGENT_SHARED_DATA=/var/lib/promptcut/agent-shared
